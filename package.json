{
  "name": "sz333-unpack-desktop",
  "productName": "sz333 解压工具",
  "version": "2.0.1",
  "description": "Windows 桌面解压工具：分卷合并 / 多层嵌套 / 加密包 / 密码锚点工作流 / 中文路径转英文",
  "author": {
    "name": "sz333",
    "email": "sz333@example.com"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --win nsis portable",
    "dist:portable": "npm run build && electron-builder --win portable",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "verify:fixes": "node --experimental-strip-types scripts/verify-fixes.mts",
    "verify:pwd-e2e": "node --experimental-strip-types scripts/verify-pwd-e2e.mts",
    "verify:dedup": "node scripts/verify-dedup.mjs",
    "verify:listing": "node scripts/verify-listing.mjs",
    "verify:syntax": "node --experimental-strip-types scripts/verify-syntax.mts",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "lucide-react": "^0.436.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.1",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
